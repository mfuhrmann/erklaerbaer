# Copy to .env and adjust (docker compose reads it automatically).

# Owner of rulebooks imported via the web page: your user (id -u / id -g).
ERKLAERBAER_UID=1000
ERKLAERBAER_GID=1000

# Optional, see README "Einstellungen":
# CACHE_RAM_MIB=12288      # Ollama prompt cache; more RAM -> more games warmed up
# VORWAERMEN=gross         # gross | alle | keine | liste (regelwerke/vorwaermen.txt)
# VORWAERMEN_PAUSE=300
# KONTEXT_TOKENS=40960
# OLLAMA_DATA=/var/lib/ollama
